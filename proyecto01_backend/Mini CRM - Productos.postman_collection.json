        "exec": [
          "pm.test('Status 201', () => {\r",
          "    pm.response.to.have.status(201);\r",
          "});\r",
          "\r",
          "pm.test('Tiene _id', () => {\r",
          "    const body = pm.response.json();\r",
          "    pm.expect(body.producto._id).to.be.a('string');\r",
          "});\r",
          "\r",
          "pm.test('Tiene timestamps', () => {\r",
          "    const body = pm.response.json();\r",
          "    pm.expect(body.producto.createdAt).to.exist;\r",
