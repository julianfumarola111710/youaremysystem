    {
      "name": "Post productos sku-generado aleatoriamente",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generar SKU aleatorio válido\r",
              "const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';\r",
              "const prefix = Array.from({length: 3}, () =>\r",
              "  letters[Math.floor(Math.random()*26)]).join('');\r",
              "const nums = String(Math.floor(Math.random()*9000)+1000);\r",
              "pm.environment.set('sku_generado', `${prefix}-${nums}`);\r",
              "// → Genera: \"ELE-4827\", \"HOG-2391\", etc."
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
