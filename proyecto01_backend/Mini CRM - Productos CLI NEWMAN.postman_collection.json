    {
      "name": "Get productos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Respuesta contiene productos', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.productos).to.be.an('array');",
              "});",
              "",
              "pm.test('Primer producto tiene _id', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.productos[0]._id).to.be.a('string');",
              "});",
              "",
              "pm.test('Primer producto tiene timestamps', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.productos[0].createdAt).to.exist;",
              "    pm.expect(body.productos[0].updatedAt).to.exist;",
              "});"
            ]
          }
        }
      ],
