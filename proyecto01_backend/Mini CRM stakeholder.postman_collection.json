  "item": [
    {
      "name": "Post stake holders(cliente)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Limpia el ID anterior para evitar confusión\r",
              "pm.environment.unset(\"stakeholder_id1\");\r",
              "console.log(\"ID anterior limpiado. Listo para crear nuevo stakeholder.\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 201 - Creado exitosamente\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Respuesta tiene _id\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.data).to.have.property(\"_id\");\r",
              "});\r",
              "\r",
              "pm.test(\"success es true\", function () {\r",
              "    pm.expect(pm.response.json().success).to.eql(true);\r",
              "});\r",
              "\r",
              "//  Guarda el ID dinámicamente\r",
              "const json = pm.response.json();\r",
              "if (json.data && json.data._id) {\r",
              "    pm.environment.set(\"stakeholder_id1\", json.data._id);\r",
              "    console.log(\"ID guardado automáticamente:\", json.data._id);\r",
              "} else {\r",
              "    console.error(\" No se pudo guardar el ID. Revisa la respuesta.\");\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
